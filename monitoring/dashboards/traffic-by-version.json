{
  "title": "Traffic by version",
  "uid": "mesh-traffic-by-version",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "service (prefix)",
        "type": "textbox",
        "query": "data-001",
        "current": { "text": "data-001", "value": "data-001" },
        "options": [{ "selected": true, "text": "data-001", "value": "data-001" }]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests/s by service or version (waypoint)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{destination_service_name}}",
          "expr": "sum by (destination_service_name) (rate(istio_requests_total{reporter=\"waypoint\",destination_service_name=~\"$service.*\"}[1m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Success ratio (non-5xx)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{destination_service_name}}",
          "expr": "sum by (destination_service_name) (rate(istio_requests_total{reporter=\"waypoint\",destination_service_name=~\"$service.*\",response_code!~\"5.*\"}[1m])) / sum by (destination_service_name) (rate(istio_requests_total{reporter=\"waypoint\",destination_service_name=~\"$service.*\"}[1m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency (ms)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{destination_service_name}}",
          "expr": "histogram_quantile(0.95, sum by (le, destination_service_name) (rate(istio_request_duration_milliseconds_bucket{reporter=\"waypoint\",destination_service_name=~\"$service.*\"}[1m])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "k6: user requests/s and failures/s",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "requests", "expr": "sum(rate(k6_http_reqs_total[30s]))" },
        { "refId": "B", "legendFormat": "failed", "expr": "sum(rate(k6_http_reqs_total{expected_response=\"false\"}[30s]))" }
      ]
    }
  ]
}
